{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noImplicitOverride": true, "noUncheckedIndexedAccess": true,
    "rootDir": "src", "outDir": "dist", "declaration": true,
    "sourceMap": true, "esModuleInterop": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
